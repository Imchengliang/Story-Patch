CANONGUARD_ENVIRONMENT=local
CANONGUARD_API_HOST=127.0.0.1
CANONGUARD_API_PORT=8000

# Local SQLite fallback (no Docker required):
# CANONGUARD_DATABASE_URL=sqlite:///./canonguard.db
# Docker Compose (host ports 5433/7688 avoid local Postgres/Neo4j conflicts):
CANONGUARD_DATABASE_URL=postgresql+psycopg://canonguard:canonguard@127.0.0.1:5433/canonguard
CANONGUARD_AUTO_CREATE_TABLES=false

CANONGUARD_NEO4J_URI=bolt://127.0.0.1:7688
CANONGUARD_NEO4J_USER=neo4j
CANONGUARD_NEO4J_PASSWORD=canonguard

CANONGUARD_MINIO_ENDPOINT=127.0.0.1:9000
CANONGUARD_MINIO_ACCESS_KEY=canonguard
CANONGUARD_MINIO_SECRET_KEY=canonguard
CANONGUARD_MINIO_SECURE=false

CANONGUARD_VALKEY_URL=redis://127.0.0.1:6379/0

# LLM roles: fill with provider-specific model names, e.g. openai/gpt-4o-mini
CANONGUARD_LLM_EXTRACTOR_MODEL=
CANONGUARD_LLM_GAP_MODEL=
CANONGUARD_LLM_PLANNER_MODEL=
CANONGUARD_LLM_WRITER_MODEL=
CANONGUARD_LLM_REVIEWER_MODEL=
CANONGUARD_LLM_AUDITOR_MODEL=
CANONGUARD_LLM_JUDGE_MODEL=

# Provider keys are read by LiteLLM from their standard env vars:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Test LLM providers (also read from the root .env):
# QWEN38_27B_FP8_BASE_URL=
# QWEN38_27B_FP8_API_KEY=
# QWEN38_27B_FP8_MODEL=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
